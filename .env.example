# Polygon.io API Key - get yours at https://polygon.io/dashboard
POLYGON_API_KEY=your_polygon_api_key_here

# Anthropic API Key - get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Bot Token - create a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID(s) - comma-separated list of allowed chat IDs
# To find your chat ID, message @userinfobot on Telegram
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Morning brief time (24h format, ET timezone)
MORNING_BRIEF_HOUR=7
MORNING_BRIEF_MINUTE=0

# Screener run time (should be before morning brief)
SCREENER_HOUR=6
SCREENER_MINUTE=30

# Max concurrent Polygon API requests (adjust based on your plan)
# Starter: 5/min, Developer/Advanced: unlimited
POLYGON_MAX_CONCURRENT=5
